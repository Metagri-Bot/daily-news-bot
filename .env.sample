# === Discord Bot 基本設定 ===
# Discord Developer Portalから取得したBotのトークン
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ニュースを投稿するDiscordチャンネルのID
NEWS_CHANNEL_ID=YOUR_NEWS_POSTING_CHANNEL_ID_HERE

# 海外文献投稿用チャンネルID
GLOBAL_RESEARCH_CHANNEL_ID=your_global_research_channel_id

# === 情報収集用設定 ===
INFO_GATHERING_CHANNEL_ID=YOUR_INFO_GATHERING_CHANNEL_ID_HERE

# === Google Apps Script用設定 ===
# GASをウェブアプリとしてデプロイした際に取得したURL
GOOGLE_APPS_SCRIPT_URL=YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE
# 農業AI通信専用GAS WebアプリURL
AI_GUIDE_GAS_URL=YOUR_AI_GUIDE_GAS_WEB_APP_URL_HERE


# === ロール判定用設定 ===
# サーバーで「開発者モード」をオンにして、各ロールを右クリック→「IDをコピー」で取得
BIGNER_ROLE_ID=YOUR_BIGNER_ROLE_ID_HERE
METAGRI_ROLE_ID=YOUR_METAGRI_ROLE_ID_HERE


# === ニュースソース設定 ===
# 取得したいRSSフィードのURLをカンマ(,)区切りで指定します。
# この値はGitHub ActionsのSecretsで管理することも推奨されます。
NEWS_RSS_FEEDS_AGRICULTURE=https://www.agrinews.co.jp/feed/distribution/index.xml,https://agri.mynavi.jp/feed/
NEWS_RSS_FEEDS_WEB3=https://coinpost.jp/rss,https://news.yahoo.co.jp/rss/media/neweco/all.xml
# 海外文献のRSSフィード（カンマ区切り）
GLOBAL_RSS_FEEDS="https://example.com/feed1,https://example.com/feed2"

# === AI活用 ===
OPENAI_API_KEY=your_openai_api_key_here
# ニュース分析・翻訳・新刊選定・農業AI通信で共通利用するモデル
OPENAI_MODEL=gpt-5.6-luna

# === Roblox ===
ROBLOX_NEWS_CHANNEL_ID="YOUR_ROBLOX_NEWS_CHANNEL_ID"
# 2026-09-18にこのサーバーから取得できたフィード。広域フィードは見出し・要約にRoblox言及
# がある項目だけを収集します。追加候補の可否は scripts/check-roblox-feeds.js で実測してください。
ROBLOX_RSS_FEEDS="https://devforum.roblox.com/c/updates/45.rss,https://devforum.roblox.com/c/updates/release-notes.rss,https://techcrunch.com/tag/roblox/feed/,https://www.gamesindustry.biz/feed,https://www.gamedeveloper.com/rss.xml,https://naavik.co/feed/,https://toybook.com/feed/,https://toyworldmag.co.uk/feed/,https://www.marketingdive.com/feeds/news/,https://digiday.com/feed/,https://www.glossy.co/feed/,https://www.modernretail.co/feed/,https://www.retaildive.com/feeds/news/,https://www.fashionista.com/.rss/full/"

# === 新刊紹介機能 ===
# 農業・Web3・先端技術関連の新刊を投稿するチャンネルID
NEW_BOOK_CHANNEL_ID=YOUR_NEW_BOOK_CHANNEL_ID_HERE
# 小説・ビジネス書・話題の新刊を投稿するチャンネルID
POPULAR_BOOK_CHANNEL_ID=YOUR_POPULAR_BOOK_CHANNEL_ID_HERE
# 楽天Books APIのアプリケーションID（https://webservice.rakuten.co.jp/ から取得）
RAKUTEN_APP_ID=YOUR_RAKUTEN_APP_ID_HERE

# === 監視用Discord Webhook ===
# BOTの稼働状況やエラーを監視用Discordチャンネルへ通知します
# Discord Webhookを作成し、URLの webhook_id/webhook_token 部分を設定
# 例: https://discord.com/api/webhooks/1234567890123456789/abcdefghijklmnopqrstuvwxyz
#     → MONITORING_WEBHOOK_URL=1234567890123456789/abcdefghijklmnopqrstuvwxyz
MONITORING_WEBHOOK_URL=

# === 農業AI通信のDiscord投稿リンクUTM設定 ===
# 未設定の場合は DISCORD_UTM_SOURCE=discord / DISCORD_UTM_MEDIUM=social が使われます
DISCORD_UTM_SOURCE=discord
DISCORD_UTM_MEDIUM=social

# === 官公庁・自治体 公募モニター ===
# 投稿先チャンネル。未設定の場合は NEWS_CHANNEL_ID に投稿します
PUBLIC_OPPORTUNITY_CHANNEL_ID=
# 実行スケジュール（既定は平日7:30 JST）
PUBLIC_OPPORTUNITY_CRON=30 7 * * 1-5
# 通知の下限点（S・Aランクかつこの点数以上のみ通知。既定65）
PUBLIC_OPPORTUNITY_MIN_SCORE=65
# 監視先の優先度上限（1=国の主要機関のみ / 2=技術・中小企業系まで / 3=自治体まで。既定3）
PUBLIC_OPPORTUNITY_MAX_PRIORITY=3
# true にすると公募モニターを停止します
DISABLE_PUBLIC_OPPORTUNITY=false
# 公募モニターと千葉県レーダーで共通利用するOpenAIモデル
PUBLIC_OPPORTUNITY_OPENAI_MODEL=gpt-5.6-luna

# === 千葉県自治体案件レーダー（火・金 8:50 JST） ===
# 千葉県＋近隣6市の企画提案（プロポーザル）・公募を収集する。
# 上の公募モニター（省庁・全国）とは別モジュール・別履歴シート（Chiba_Tenders）。
# 投稿先チャンネル。専用チャンネルを推奨。未設定なら PUBLIC_OPPORTUNITY_CHANNEL_ID → NEWS_CHANNEL_ID の順にフォールバック
CHIBA_TENDER_CHANNEL_ID=
# 実行スケジュール（既定は火・金 8:50 JST）
CHIBA_TENDER_CRON=50 8 * * 2,5
# 通知の下限点（既定60。母集団が小さいため公募モニターの65より低く取る）
CHIBA_TENDER_MIN_SCORE=60
# 個別Embedで立てる下限点（既定80。これ未満はダイジェストへまとめる）
CHIBA_TENDER_ALERT_SCORE=80
# 監視先の優先度上限（1=白井市・千葉県のみ / 2=近隣6市まで。既定2）
CHIBA_TENDER_MAX_PRIORITY=2
# AIモデルは上の PUBLIC_OPPORTUNITY_OPENAI_MODEL を使用
# true にすると千葉県案件レーダーを停止します
DISABLE_CHIBA_TENDER=false
# 農家・食品パートナー案件レーダー（平日8:20、新規・重要更新のみ）
FARM_PARTNER_CHANNEL_ID=
FARM_PARTNER_CRON=20 8 * * 1-5
FARM_PARTNER_MIN_SCORE=65
DISABLE_FARM_PARTNER_RADAR=false

# === Discordチャンネル投稿ログ（日次バッチ / 既定 毎日 5:10 JST） ===
# 指定したチャンネル直下の投稿を、専用スプレッドシートへ日次でまとめて記録します。
# リアルタイム監視はしません（取得の起点は「前回記録した最後のMessage ID」）。
# 対象チャンネルID。カンマ区切りで複数指定可（開発者モード→チャンネル右クリック→IDをコピー）
DISCORD_CHANNEL_LOG_CHANNEL_IDS=
# 専用のGASウェブアプリURL（ChannelLogCode.gs をデプロイしたもの。既存GASとは別プロジェクト）
DISCORD_CHANNEL_LOG_GAS_URL=
# 実行スケジュール（既定は毎日5:10 JST＝他ジョブが動き出す6:00より前）
DISCORD_CHANNEL_LOG_CRON=10 5 * * *
# Botの投稿も記録するか（既定 true。false にすると人間の発言だけになる）
DISCORD_CHANNEL_LOG_INCLUDE_BOTS=true
# シートに記録が1件も無いチャンネルで、初回だけ何日ぶん遡るか（既定7日）
DISCORD_CHANNEL_LOG_INITIAL_LOOKBACK_DAYS=7
# 1チャンネル1実行あたりの取得上限（既定1000。超えた分は次の実行で続きから取る）
DISCORD_CHANNEL_LOG_MAX_PER_RUN=1000
# true にするとチャンネル投稿ログを停止します
DISABLE_DISCORD_CHANNEL_LOG=false

# === 日誌素案（週次バッチ / 毎週金曜） ===
# 前日ぶんのDiscord投稿を、01_input/discord-log_YYYY-MM-DD.md と同じ生ログ形式のまま
# 「日誌素案」チャンネルへ投稿します。2,000字を超える場合は複数メッセージへ自動分割します。
# 投稿先チャンネルID（空のときはジョブを登録しません）
DIARY_DRAFT_CHANNEL_ID=YOUR_DIARY_DRAFT_CHANNEL_ID_HERE
# 実行スケジュール（既定は毎週金曜6:00 JST）
DIARY_DRAFT_CRON=0 6 * * 5
# 何日前を対象にするか（既定1＝前日）
DIARY_DRAFT_OFFSET_DAYS=1
# 収集対象。未設定なら DISCORD_CHANNEL_LOG_CHANNEL_IDS を流用します
DIARY_DRAFT_SOURCE_CHANNEL_IDS=
# true にすると日誌素案の投稿を停止します
DISABLE_DIARY_DRAFT=false

# --- 日誌素案への補足（diary-supplement.js。生ログの後ろに事実だけ足す。要約や見解は入れない）---
# 投稿内URLの実情報（タイトル・説明）を機械的に取得して併記するか（既定true）
DIARY_DRAFT_LINK_SUPPLEMENT=true
# 過去実績（Discord_Channel_Logスプレッドシート）と比べた件数の傾向メモを付けるか
# DISCORD_CHANNEL_LOG_GAS_URL が未設定の場合は自動的に省かれる（既定true）
DIARY_DRAFT_TREND_SUPPLEMENT=true
# 傾向メモで遡る日数（既定14。対象日自体は平均から除外される）
DIARY_DRAFT_TREND_DAYS=14
